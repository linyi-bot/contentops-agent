# 复制成 .env 后填值；.env 已在 .gitignore 里，不会被提交。
# 项目根目录的 .env 会被 CLI 自动读取（`build_llm()` 里，不用装 python-dotenv），
# 规则跟 docker compose 一致：**已经存在的环境变量优先**，.env 只补空。
# 用记事本存出来的 BOM 也兼容（首行 key 不会被读成 "\ufeffLLM_PROVIDER"）。
# 不填 key 时自动使用 mock 模型，项目照样能跑（这也是 CI 里跑的口径）。
#
# 填完之后先跑一条：
#   scripts\dev.cmd llm-check
# 它只花几十个 token，能立刻告诉你 key / 模型名 / 网络哪一处不对。

LLM_PROVIDER=mock          # mock | deepseek
LLM_MODEL=deepseek-flash   # 官方枚举只有 deepseek-flash / deepseek-v4-pro，写 deepseek-chat 会 400
LLM_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=

# 思考模式默认关：草稿这种活不需要思维链，开着只是多花输出 token。
# 真要开就填 on，并可选 LLM_REASONING_EFFORT=low|high|max。
LLM_THINKING=off

# 超时与重试（秒 / 次数）。429 和 5xx 会退避重试，401/400 不重试。
LLM_TIMEOUT=60
LLM_RETRIES=2

# 相关度闸门：低于这个分就按「知识库没资料」处理，不拿不相关的资料硬凑。
# 0.09 是在 30 条黄金集上校准的，换语料要重标；填 0 等于关掉闸门。
RETRIEVAL_MIN_SCORE=0.09

# 单价（元 / 百万 tokens）。留空则按官方「空闲/高峰」两档自动取价；
# 三个都填了就一律用你填的价，不再分时段。
# LLM_PRICE_IN_HIT=
# LLM_PRICE_IN_MISS=
# LLM_PRICE_OUT=
